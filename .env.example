# Copy this file to ".env" and edit it. Lines starting with # are comments.
# The project also runs with no .env file at all (local development).

DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-me-to-a-long-random-text
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Optional
# SQLITE_PATH=C:\data\fittrack.sqlite3
# SITE_URL=http://192.168.1.5:8000
# REMINDER_TOKEN=a-long-secret-for-the-daily-reminder-link
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=